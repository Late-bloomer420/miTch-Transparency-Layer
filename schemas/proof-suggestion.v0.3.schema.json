{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://late-bloomer420.github.io/miTch-Transparency-Layer/schemas/proof-suggestion.v0.3.schema.json",
  "title": "AskMI Proof Suggestion v0.3",
  "description": "Advisory, local-only data-minimization suggestion emitted by the miTch Transparency Layer Proof Bridge. Never authorizes or triggers OID4VP disclosure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "askmiProofSuggestion"
  ],
  "properties": {
    "askmiProofSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contractVersion",
        "generatedAt",
        "page",
        "observedOverCollection",
        "suggestedMinimalClaims",
        "rationale",
        "note"
      ],
      "properties": {
        "version": {
          "const": "0.3.0"
        },
        "contractVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "minLength": 10
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "title"
          ],
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observedOverCollection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "birthdate"
            ]
          }
        },
        "suggestedMinimalClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "age_over_18"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
